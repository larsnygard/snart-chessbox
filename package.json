{
  "name": "snart-chessbox",
  "version": "1.11.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Offline chess trainer: opening repertoires, endgame technique, tactics puzzles and game memory against Stockfish (PWA).",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/larsnygard/snart-chessbox",
  "scripts": {
    "start": "python3 -m http.server 8741",
    "test": "node --test tests/",
    "test:browser": "node tools/browser-check.mjs",
    "test:flows": "node tools/flows-check.mjs",
    "verify:endgames": "node tools/verify-endgames.mjs",
    "build:openings": "node tools/build-openings.mjs",
    "build:packs": "node tools/build-packs.mjs",
    "icons": "python3 tools/make-icons.py",
    "pieces": "python3 tools/make-pieces.py"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
